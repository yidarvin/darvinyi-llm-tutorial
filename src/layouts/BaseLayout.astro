---
import '@/styles/global.css';
import SearchDialog from '@components/search/SearchDialog';
import SkipLink from '@components/a11y/SkipLink';
import SEO from '@components/seo/SEO.astro';
import JsonLd from '@components/seo/JsonLd.astro';

export interface Props {
  title?: string;
  description?: string;
  /** Chapter slug (empty for home). Drives canonical URL and OG image lookup. */
  slug?: string;
  /** OG type. Chapters pass 'article', everything else defaults to 'website'. */
  ogType?: 'website' | 'article';
  /** ISO datestring for article:published_time. */
  publishedTime?: string;
  /** Which JSON-LD payload to emit, if any. */
  jsonLdKind?: 'home' | 'chapter' | 'none';
  /** Chapter number, for LearningResource position. */
  chapterNum?: number;
  /** Part name (e.g. "Foundations"), for LearningResource educationalAlignment. */
  partName?: string;
}

const {
  title = 'LLM Tutorial',
  description = 'A comprehensive tutorial from numpy primitives to LLM agent frameworks. By Darvin Yi.',
  slug = '',
  ogType = 'website',
  publishedTime,
  jsonLdKind = 'none',
  chapterNum,
  partName,
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link rel="preload" href="/fonts/inter/Inter-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono/JetBrainsMono-Variable.ttf" as="font" type="font/ttf" crossorigin />

    <SEO
      title={title}
      description={description}
      slug={slug}
      type={ogType}
      publishedTime={publishedTime}
    />
    {jsonLdKind !== 'none' && (
      <JsonLd
        kind={jsonLdKind}
        slug={slug}
        title={title}
        description={description}
        chapterNum={chapterNum}
        partName={partName}
      />
    )}
  </head>
  <body>
    <SkipLink />
    <slot />
    <SearchDialog client:idle />
  </body>
</html>
