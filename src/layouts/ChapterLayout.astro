---
import BaseLayout from './BaseLayout.astro';
import Sidebar from '@components/nav/Sidebar.astro';
import MobileNav from '@components/nav/MobileNav.astro';
import TableOfContents from '@components/nav/TableOfContents.astro';
import ChapterNav from '@components/nav/ChapterNav.astro';
import Footer from '@components/nav/Footer.astro';
import RelatedChapters from '@components/content/RelatedChapters';
import { getChapter } from '@lib/chapters';

export interface Props {
  slug?: string;
  description?: string;
  frontmatter?: { slug?: string; description?: string };
}
const props = Astro.props as Props;
const slug = props.slug ?? props.frontmatter?.slug ?? '';
const description = props.description ?? props.frontmatter?.description;
const chapter = getChapter(slug);
const pageTitle = chapter ? `${chapter.num}. ${chapter.title}` : 'Chapter';
---
<BaseLayout title={pageTitle} description={description}>
  <div class="chapter-layout">
    <Sidebar />
    <MobileNav />

    <div class="chapter-layout-main">
      <main id="main-content" class="chapter-content" role="main">
        {chapter && (
          <header class="chapter-header">
            <div class="chapter-eyebrow">Chapter {chapter.num}</div>
            <h1 class="chapter-title">{chapter.title}</h1>
            {description && <p class="chapter-description">{description}</p>}
            <button
              id="toc-trigger"
              class="toc-trigger"
              type="button"
              aria-controls="chapter-toc"
              aria-expanded="false"
              onclick="document.dispatchEvent(new CustomEvent('open-toc'))"
            >
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <line x1="3" y1="6"  x2="14" y2="6" />
                <line x1="3" y1="12" x2="14" y2="12" />
                <line x1="3" y1="18" x2="11" y2="18" />
              </svg>
              <span>On this page</span>
            </button>
          </header>
        )}

        <slot />

        <RelatedChapters slug={slug} />

        <ChapterNav currentSlug={slug} />
      </main>

      <TableOfContents />
    </div>
  </div>

  <Footer />
</BaseLayout>

<style>
  .chapter-layout {
    display: flex;
    min-height: 100vh;
  }

  .chapter-layout-main {
    flex: 1;
    min-width: 0;
    display: flex;
    justify-content: center;
    padding: 0 1.5rem;
  }
  @media (min-width: 1024px) {
    .chapter-layout-main { padding: 0 2.5rem; }
  }

  .chapter-content {
    flex: 1;
    min-width: 0;
    max-width: calc(var(--container-prose) + 4rem);
    padding: 4rem 0;
  }

  .chapter-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-default);
  }
  .chapter-eyebrow {
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--cyan-500);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }
  .chapter-title {
    margin-top: 0;
    margin-bottom: 0.75rem;
  }
  .chapter-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin: 0;
    max-width: var(--container-prose);
  }

  /* TOC drawer trigger — visible only below the desktop TOC breakpoint */
  .toc-trigger {
    display: none;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
    padding: 0.55rem 0.9rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border-default);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    cursor: pointer;
    min-height: 44px;
    transition: border-color 200ms, color 200ms;
  }
  .toc-trigger:hover {
    border-color: var(--cyan-500);
    color: var(--cyan-300);
  }
  @media (max-width: 1279px) {
    .toc-trigger { display: inline-flex; }
  }

  /* Narrow-viewport overrides (session 134 mobile pass).
   * Heading element sizes (h1-h4) live in src/styles/responsive.css;
   * the layout-class adjustments live here so they coexist with
   * the scoped styles above. */
  @media (max-width: 720px) {
    .chapter-layout-main { padding: 0 1rem; }
    .chapter-content { padding: 2.5rem 0; }
    .chapter-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }
    .chapter-title { font-size: 32px; }
    .chapter-description { font-size: 1rem; }
  }
  @media (max-width: 380px) {
    .chapter-layout-main { padding: 0 0.85rem; }
    .chapter-title { font-size: 28px; }
  }
</style>
