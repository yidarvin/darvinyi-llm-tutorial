{
  "name": "darvinyi-llm-tutorial",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build:search-index": "node scripts/build-search-index.mjs",
    "build:og-cards": "node scripts/build-og-cards.mjs",
    "subset:fonts": "node scripts/subset-fonts.mjs",
    "check:content": "node scripts/check-content-integrity.mjs",
    "check:runnables": "node scripts/check-runnable-code.mjs",
    "check:widgets": "node scripts/check-widget-data.mjs",
    "predev": "npm run build:search-index",
    "prebuild": "npm run check:content && npm run check:runnables && npm run check:widgets && npm run build:search-index && npm run build:og-cards",
    "dev": "astro dev",
    "build": "node scripts/clean-dist.mjs && astro build",
    "preview": "astro preview",
    "typecheck": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.0",
    "@astrojs/react": "^4.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/tailwind": "^6.0.0",
    "@codemirror/commands": "^6.0.0",
    "@codemirror/lang-python": "^6.0.0",
    "@codemirror/language": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@lezer/highlight": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^5.0.0",
    "codemirror": "^6.0.0",
    "github-slugger": "^2.0.0",
    "katex": "^0.16.0",
    "minisearch": "^7.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "rehype-autolink-headings": "^7.0.0",
    "rehype-katex": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "satori-html": "^0.3.2",
    "tailwindcss": "^3.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "astro-eslint-parser": "^3.0.0",
    "eslint": "^10.7.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "prettier": "^3.9.5",
    "prettier-plugin-astro": "^0.14.1",
    "pyodide": "^0.26.4",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "wawoff2": "^2.0.1"
